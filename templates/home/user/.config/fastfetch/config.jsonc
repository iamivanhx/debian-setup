// fastfetch — Gruvbox-toned, debian-branded splash for new shells.
// Run `fastfetch` (or alias it to greet you on shell start in 50-shell).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "yellow", "title": "blue", "output": "white" },
    "key": { "width": 11 }
  },
  "modules": [
    "break",
    { "type": "title", "color": { "user": "yellow", "at": "white", "host": "blue" } },
    { "type": "separator", "string": "─" },
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "host", "key": "Host" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell", "key": "Shell" },
    { "type": "wm", "key": "WM" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "RAM" },
    { "type": "disk", "key": "Disk" },
    { "type": "localip", "key": "Local IP", "format": "{ipv4}" },
    { "type": "break" },
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
    "break"
  ]
}
