# 40-desktop: GNOME look-and-feel defaults.
# System-wide dconf defaults compiled into /etc/dconf/db/local by `dconf update`.
# Users can still override via their own dconf user-db (gsettings, GNOME Settings).
# On a fresh install the system-db wins until the user changes something.

[org/gnome/desktop/interface]
gtk-theme='Gruvbox-Dark-Medium'
icon-theme='Gruvbox-Plus-Dark'
cursor-theme='Bibata-Modern-Classic'
cursor-size=24
color-scheme='prefer-dark'
accent-color='orange'
font-name='Inter Variable 11'
document-font-name='Inter Variable 11'
monospace-font-name='JetBrainsMono Nerd Font Mono 12'
font-antialiasing='rgba'
font-hinting='slight'
clock-show-weekday=true
clock-show-seconds=false
show-battery-percentage=true
enable-animations=true
toolkit-accessibility=false

[org/gnome/desktop/wm/preferences]
titlebar-font='Inter Variable Bold 11'
titlebar-uses-system-font=false
button-layout='appmenu:minimize,maximize,close'
num-workspaces=6
focus-mode='click'

[org/gnome/desktop/wm/keybindings]
close=['<Super>w']
begin-resize=['<Super>BackSpace']
maximize=['<Super>Up']
unmaximize=['<Super>Down']
toggle-fullscreen=['<Shift>F11']

[org/gnome/mutter]
dynamic-workspaces=false
edge-tiling=true
attach-modal-dialogs=true
center-new-windows=true

[org/gnome/desktop/background]
picture-uri='file:///usr/local/share/backgrounds/gruvbox-dark.svg'
picture-uri-dark='file:///usr/local/share/backgrounds/gruvbox-dark.svg'
picture-options='zoom'
primary-color='#1d2021'
secondary-color='#282828'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/local/share/backgrounds/gruvbox-dark.svg'
primary-color='#1d2021'
secondary-color='#282828'
lock-enabled=true

[org/gnome/desktop/sound]
event-sounds=false
input-feedback-sounds=false

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true
natural-scroll=true

[org/gnome/shell]
disable-user-extensions=false
enabled-extensions=['user-theme@gnome-shell-extensions.gcampax.github.com', 'dash-to-dock@micxgx.gmail.com', 'space-bar@luchrioh', 'tactile@lundal.io', 'just-perfection-desktop@just-perfection', 'appindicatorsupport@rgcjonas.gmail.com']
favorite-apps=['com.mitchellh.ghostty.desktop', 'org.gnome.Nautilus.desktop', 'firefox-esr.desktop', 'code.desktop']

[org/gnome/shell/extensions/tactile]
col-0=1
col-1=2
col-2=1
col-3=0
row-0=1
row-1=1
gap-size=8

[org/gnome/shell/extensions/just-perfection]
animation=2
dash-app-running=true
workspace=true
workspace-popup=false
window-demands-attention-focus=true
startup-status=0

[org/gnome/shell/extensions/appindicator]
icon-saturation=0.0
icon-brightness=0.0
icon-contrast=0.0
icon-opacity=240
tray-pos='right'

[org/gnome/shell/extensions/user-theme]
name='Gruvbox-Dark-Medium'

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=false
autohide=true
intellihide=true
intellihide-mode='FOCUS_APPLICATION_WINDOWS'
transparency-mode='DYNAMIC'
running-indicator-style='DOTS'
show-mounts=false
show-trash=false
show-show-apps-button=true
click-action='focus-or-previews'
scroll-action='cycle-windows'
custom-theme-shrink=true
apply-glossy-effect=false
disable-overview-on-startup=true
icon-size-fixed=false
dash-max-icon-size=48
animation-time=0.15
hide-delay=0.2
show-delay=0.15

[org/gnome/shell/extensions/space-bar/behavior]
show-empty-workspaces=true
smart-workspace-names=false
scroll-wheel='disabled'

[org/gnome/shell/extensions/space-bar/appearance]
active-workspace-background-color='rgb(215,153,33)'
active-workspace-text-color='rgb(29,32,33)'
active-workspace-border-color='rgba(0,0,0,0)'
inactive-workspace-background-color='rgb(60,56,54)'
inactive-workspace-text-color='rgb(168,153,132)'
inactive-workspace-border-color='rgba(0,0,0,0)'
empty-workspace-background-color='rgba(0,0,0,0)'
empty-workspace-text-color='rgb(102,92,84)'
empty-workspace-border-color='rgba(0,0,0,0)'
workspaces-bar-padding=4
workspace-margin=2

[org/gnome/shell/extensions/space-bar/shortcuts]
enable-activate-workspace-shortcuts=true
enable-move-to-workspace-shortcuts=true

[org/gnome/settings-daemon/plugins/color]
night-light-enabled=true
night-light-schedule-automatic=true
night-light-temperature=uint32 4000

[org/gnome/desktop/default-applications/terminal]
exec='ghostty'
exec-arg=''

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0]
name='Flameshot'
command='sh -c "flameshot gui"'
binding='<Control>Print'
