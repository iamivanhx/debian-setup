# I/O scheduler for NVMe SSDs — none bypasses software scheduling for hardware queues
# Note: KERNEL=="nvme[0-9]*" matches char+block devices, but ATTR{queue/scheduler}
# only exists on block devices — udev silently skips the assignment on char devices.
ACTION=="add|change", KERNEL=="nvme[0-9]*", ATTR{queue/scheduler}="none"
# Allow NVMe autonomous power state transitions (APST) — saves ~0.5-1W idle
ACTION=="add", SUBSYSTEM=="nvme", ATTR{power/control}="auto"
